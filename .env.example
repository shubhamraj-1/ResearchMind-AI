# Copy to the project-root .env. The backend also reads backend/.env if present.
# Never commit the real file.
RESEARCHMIND_SECRET_KEY=replace-with-a-long-random-secret
RESEARCHMIND_DB_PATH=data/researchmind.db
RESEARCHMIND_STORAGE_DIR=data/storage
RESEARCHMIND_MAX_UPLOAD_MB=10

# OpenAI-compatible LLM endpoint. Costs apply; see README.
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embedding endpoint. Keep the model fixed after the first upload.
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
